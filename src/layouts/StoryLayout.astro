---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'relatos'>;
}

const { entry } = Astro.props;
const { title, date, image, description } = entry.data;
const { Content } = await entry.render();
const slug = entry.slug;
---

<BaseLayout title={title} description={description} image={image}>
  <div class="page-container page-container--narrow">
    <article>
      <header class="story-header">
        <h1 class="story-title">{title}</h1>
        <p class="story-meta">{date}</p>
      </header>

      {image && <img class="story-image" src={image} alt={`Ilustración para: ${title}`} />}

      <div class="story-content">
        <Content />
      </div>
    </article>

    <nav class="story-nav" aria-label="Volver a relatos">
      <a href="/relatos/">&larr; Todos los relatos</a>
    </nav>
  </div>
</BaseLayout>
